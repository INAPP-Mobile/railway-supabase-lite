{
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "minio/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "port": 8080,
    "healthcheckPath": "/minio/health/live",
    "healthcheckTimeout": 60,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10,
    "startCommand": null,
    "volumeMounts": [
      {
        "name": "minio-data",
        "mountPath": "/data"
      }
    ]
  },
  "$schema": "https://railway.com/railway.schema.json"
}