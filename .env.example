# Supabase Lite — Environment Variables Reference
# ================================================
# All secrets use ${{ secret(N) }} in the template — never hardcode.
# These are generated automatically by Railway on first deploy.

# --- Shared (root-level) variables ---
POSTGRES_PASSWORD= # Auto: ${{ secret(32) }} — master DB password used by all services
JWT_SECRET=        # Auto: ${{ secret(64) }} — HS256 signing key for ANON_KEY & SERVICE_ROLE_KEY
ANON_KEY=          # Auto: ${{ secret(128) }} — public client JWT
SERVICE_ROLE_KEY=  # Auto: ${{ secret(128) }} — server-side full-access JWT
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD= # Auto: ${{ secret(16) }} — admin dashboard password

# --- Postgres (image: supabase/postgres:15.8.1.085) ---
# POSTGRES_PASSWORD (shared)
# POSTGRES_DB=postgres
# Volume: /var/lib/postgresql/data (size 10GB)
# PGDATA: /var/lib/postgresql/data/pgdata (subdirectory — see postgres/Dockerfile fix)

# --- MinIO (image: minio/minio:RELEASE.2024-11-07T00-52-20Z) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD= # Auto: ${{ secret(32) }} via minio.MINIO_ROOT_PASSWORD
# Volume: /data (size 5GB)
# startCommand: minio server /data --console-address :9001

# --- Auth / GoTrue (image: supabase/gotrue:v2.186.0) ---
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
GOTRUE_DB_DRIVER=postgres
GOTRUE_JWT_EXP=3600
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
# GOTRUE_DB_DATABASE_URL, GOTRUE_JWT_SECRET, API_EXTERNAL_URL, GOTRUE_SITE_URL are auto-wired

# --- PostgREST (image: postgrest/postgrest:v14.8) ---
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_ANON_ROLE=anon
# PGRST_DB_URI, PGRST_JWT_SECRET are auto-wired

# --- Realtime (image: supabase/realtime:v2.76.5) ---
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres
DB_AFTER_CONNECT_QUERY=SET search_path TO _realtime
ERL_AFLAGS=-proto_dist inet_tcp
ENABLE_TAILSCALE=false
DNS_NODES=
# DB_HOST, DB_PASSWORD, JWT_SECRET, API_JWT_SECRET, SECRET_KEY_BASE are auto-wired

# --- Storage API (image: supabase/storage-api:v1.48.26) ---
FILE_SIZE_LIMIT=52428800
STORAGE_BACKEND=s3
FILE_STORAGE_BACKEND_PATH=/tmp
GLOBAL_S3_BUCKET=supabase-storage
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
ENABLE_IMAGE_TRANSFORMATION=false
# ANON_KEY, SERVICE_ROLE_KEY, PGRST_JWT_SECRET, DATABASE_URL, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_S3_ENDPOINT are auto-wired

# --- Kong (image: kong:3.9.1) ---
KONG_PROXY_LISTEN=0.0.0.0:8000
# AUTH_HOST, REST_HOST, REALTIME_HOST, STORAGE_HOST are auto-wired via private domains
